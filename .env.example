SERVER_PORT=8080
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_MODEL_V1=qwen3:8b
OLLAMA_MODEL_V2=qwen3:8b
OLLAMA_TIMEOUT_SEC=300
ANALYSIS_BATCH_MAX_REVIEWS=50
ANALYSIS_BATCH_MAX_CHARS=14000

# Active database configuration
# Supported drivers: postgres, mysql
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_MAX_CONNS=5
DATABASE_MIN_CONNS=0
DATABASE_HEALTH_TIMEOUT_SEC=5

# Legacy Postgres/Supabase aliases still supported
# SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require
# SUPABASE_DB_MAX_CONNS=5
# SUPABASE_DB_MIN_CONNS=0
# SUPABASE_DB_HEALTH_TIMEOUT_SEC=5

# Alternative MySQL example
# DATABASE_DRIVER=mysql
# DATABASE_URL=review_user:review_password@tcp(127.0.0.1:3306)/ai_game_review_analyzer?parseTime=true&charset=utf8mb4
# DATABASE_MAX_CONNS=10
# DATABASE_MIN_CONNS=2
# DATABASE_HEALTH_TIMEOUT_SEC=5

# MySQL-specific aliases also supported
# MYSQL_DB_URL=review_user:review_password@tcp(127.0.0.1:3306)/ai_game_review_analyzer?parseTime=true&charset=utf8mb4
# MYSQL_DB_MAX_CONNS=10
# MYSQL_DB_MIN_CONNS=2
# MYSQL_DB_HEALTH_TIMEOUT_SEC=5

# Optional for local MySQL integration testing
# RUN_MYSQL_INTEGRATION=1
# MYSQL_INTEGRATION_DSN=review_user:review_password@tcp(127.0.0.1:3306)/ai_game_review_analyzer?parseTime=true&charset=utf8mb4
